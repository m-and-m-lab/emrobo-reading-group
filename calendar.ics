---
layout: null
permalink: /calendar.ics
---
BEGIN:VCALENDAR
VERSION:2.0
PRODID:-//Embodiment & Skills Learning Reading Group//Schedule//EN
CALSCALE:GREGORIAN
METHOD:PUBLISH
X-WR-CALNAME:{{ site.title }}
X-WR-TIMEZONE:{{ site.timezone }}
REFRESH-INTERVAL;VALUE=DURATION:PT12H
X-PUBLISHED-TTL:PT12H
BEGIN:VTIMEZONE
TZID:America/Detroit
BEGIN:DAYLIGHT
TZOFFSETFROM:-0500
TZOFFSETTO:-0400
TZNAME:EDT
DTSTART:19700308T020000
RRULE:FREQ=YEARLY;BYMONTH=3;BYDAY=2SU
END:DAYLIGHT
BEGIN:STANDARD
TZOFFSETFROM:-0400
TZOFFSETTO:-0500
TZNAME:EST
DTSTART:19701101T020000
RRULE:FREQ=YEARLY;BYMONTH=11;BYDAY=1SU
END:STANDARD
END:VTIMEZONE
{% assign cal_sessions = site.data.sessions | sort: "date" -%}
{%- comment -%} Build time in UTC, so every rebuild marks events as updated. site.time is local (site.timezone). {%- endcomment -%}
{%- assign cal_z = site.time | date: "%z" -%}
{%- assign cal_off = cal_z | slice: 1, 2 | plus: 0 | times: 60 | plus: 0 -%}
{%- assign cal_off = cal_z | slice: 3, 2 | plus: cal_off | times: 60 -%}
{%- assign cal_epoch = site.time | date: "%s" | plus: 0 -%}
{%- if cal_z contains "-" -%}{%- assign cal_utc = cal_epoch | plus: cal_off -%}{%- else -%}{%- assign cal_utc = cal_epoch | minus: cal_off -%}{%- endif -%}
{%- assign cal_stamp = cal_utc | date: "%Y%m%dT%H%M%SZ" -%}
{%- assign cal_host = site.url | remove: "https://" | remove: "http://" -%}
{%- for s in cal_sessions -%}
{%- include session-times.html session=s -%}
{%- capture cal_title -%}{% if st_type == "tooling" %}[Tooling] {% elsif st_type == "invited" %}[Invited talk] {% endif %}{{ s.title }}{%- endcapture -%}
{%- capture cal_desc -%}{% if s.presenter %}{% if st_type == "invited" %}Speaker{% else %}Presenter{% endif %}: {{ s.presenter }}\n{% endif %}{% if s.paper_url %}Paper: {{ s.paper_url }}\n{% endif %}{% if site.links.zoom_url != "" %}Zoom: {{ site.links.zoom_url }}{% if site.links.zoom_id != "" %} (meeting ID {{ site.links.zoom_id }}){% endif %}\n{% endif %}Details: {{ '/sessions/' | absolute_url }}#{{ st_id }}{%- endcapture %}
BEGIN:VEVENT
UID:{{ st_id }}@{{ cal_host }}
DTSTAMP:{{ cal_stamp }}
LAST-MODIFIED:{{ cal_stamp }}
{% if st_tbd %}DTSTART;VALUE=DATE:{{ st_date }}{% else %}DTSTART;TZID={{ site.timezone }}:{{ st_date }}T{{ st_start }}00
DTEND;TZID={{ site.timezone }}:{{ st_date }}T{{ st_end }}00{% endif %}
SUMMARY:{{ cal_title | replace: ",", "\," | replace: ";", "\;" }}
DESCRIPTION:{{ cal_desc | replace: ",", "\," | replace: ";", "\;" }}
{%- capture cal_loc -%}{{ st_location }}{% if st_location == site.meeting.location and site.meeting.address %}, {{ site.meeting.address }}{% endif %}{%- endcapture %}
LOCATION:{{ cal_loc | replace: ",", "\," | replace: ";", "\;" }}
URL:{{ '/sessions/' | absolute_url }}#{{ st_id }}
{% if s.tentative %}STATUS:TENTATIVE
{% endif %}END:VEVENT
{% endfor -%}
END:VCALENDAR
